{
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "bin/yt-dlp.exe": "yt-dlp.exe",
      "bin/ffmpeg.exe": "ffmpeg.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
