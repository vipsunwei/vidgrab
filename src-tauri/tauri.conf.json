{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidGrab",
  "version": "0.0.1",
  "identifier": "com.sunwei.vidgrab",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build && node scripts/fetch-binaries.ts",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VidGrab",
        "width": 1200,
        "height": 720,
        "center": true,
        "decorations": true,
        "resizable": true,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/*"
    ]
  }
}
